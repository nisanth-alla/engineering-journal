---
import dockerLogo from "simple-icons/icons/docker.svg?raw";
import goLogo from "simple-icons/icons/go.svg?raw";
import javascriptLogo from "simple-icons/icons/javascript.svg?raw";
import nextLogo from "simple-icons/icons/nextdotjs.svg?raw";
import nodeLogo from "simple-icons/icons/nodedotjs.svg?raw";
import reactLogo from "simple-icons/icons/react.svg?raw";
import typescriptLogo from "simple-icons/icons/typescript.svg?raw";

interface Props {
  title: string;
  href: string;
  brand?: "docker" | "go" | "javascript" | "next" | "node" | "react" | "typescript";
  icon?: "puzzle" | "document" | "open-book" | "list-format" | "database";
}

const { title, href, brand, icon } = Astro.props;
const logos = {
  docker: dockerLogo,
  go: goLogo,
  javascript: javascriptLogo,
  next: nextLogo,
  node: nodeLogo,
  react: reactLogo,
  typescript: typescriptLogo,
};
const logo = brand ? logos[brand] : null;

const icons = {
  puzzle:
    '<path d="M17 22H5a3 3 0 0 1-3-3V9a3 3 0 0 1 3-3h1a4 4 0 0 1 7.3-2.18c.448.64.692 1.4.7 2.18h3a1 1 0 0 1 1 1v3a4 4 0 0 1 2.18 7.3A3.86 3.86 0 0 1 18 18v3a1 1 0 0 1-1 1ZM5 8a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h11v-3.18a1 1 0 0 1 1.33-.95 1.77 1.77 0 0 0 1.74-.23 2 2 0 0 0 .93-1.37 2 2 0 0 0-.48-1.59 1.89 1.89 0 0 0-2.17-.55 1 1 0 0 1-1.33-.95V8h-3.2a1 1 0 0 1-1-1.33 1.77 1.77 0 0 0-.23-1.74 1.939 1.939 0 0 0-3-.43A2 2 0 0 0 8 6c.002.23.046.456.13.67A1 1 0 0 1 7.18 8H5Z"/>',
  document:
    '<path d="M9 10h1a1 1 0 1 0 0-2H9a1 1 0 0 0 0 2Zm0 2a1 1 0 0 0 0 2h6a1 1 0 0 0 0-2H9Zm11-3.06a1.3 1.3 0 0 0-.06-.27v-.09c-.05-.1-.11-.2-.19-.28l-6-6a1.07 1.07 0 0 0-.28-.19h-.09a.88.88 0 0 0-.33-.11H7a3 3 0 0 0-3 3v14a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V8.94Zm-6-3.53L16.59 8H15a1 1 0 0 1-1-1V5.41ZM18 19a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h5v3a3 3 0 0 0 3 3h3v9Zm-3-3H9a1 1 0 0 0 0 2h6a1 1 0 0 0 0-2Z"/>',
  "open-book":
    '<path d="M21.17 2.06A13.1 13.1 0 0 0 19 1.87a12.94 12.94 0 0 0-7 2.05 12.94 12.94 0 0 0-7-2 13.1 13.1 0 0 0-2.17.19 1 1 0 0 0-.83 1v12a1 1 0 0 0 1.17 1 10.9 10.9 0 0 1 8.25 1.91l.12.07h.11a.91.91 0 0 0 .7 0h.11l.12-.07A10.899 10.899 0 0 1 20.83 16 1 1 0 0 0 22 15V3a1 1 0 0 0-.83-.94ZM11 15.35a12.87 12.87 0 0 0-6-1.48H4v-10c.333-.02.667-.02 1 0a10.86 10.86 0 0 1 6 1.8v9.68Zm9-1.44h-1a12.87 12.87 0 0 0-6 1.48V5.67a10.86 10.86 0 0 1 6-1.8c.333-.02.667-.02 1 0v10.04Z"/>',
  "list-format":
    '<path d="M3.71 16.29a1 1 0 0 0-.33-.21 1 1 0 0 0-.76 0 1 1 0 0 0-.33.21 1 1 0 0 0-.21.33 1 1 0 0 0 .21 1.09c.097.088.209.16.33.21a.94.94 0 0 0 .76 0 1.15 1.15 0 0 0 .33-.21 1 1 0 0 0 .21-1.09 1 1 0 0 0-.21-.33ZM7 8h14a1 1 0 1 0 0-2H7a1 1 0 0 0 0 2Zm-3.29 3.29a1 1 0 0 0-1.09-.21 1.15 1.15 0 0 0-.33.21 1 1 0 0 0-.21.33.94.94 0 0 0 0 .76c.05.121.122.233.21.33.097.088.209.16.33.21a.94.94 0 0 0 .76 0 1.15 1.15 0 0 0 .33-.21 1.15 1.15 0 0 0 .21-.33.94.94 0 0 0 0-.76 1 1 0 0 0-.21-.33ZM21 11H7a1 1 0 0 0 0 2h14a1 1 0 0 0 0-2ZM3.71 6.29a1 1 0 0 0-.33-.21 1 1 0 0 0-1.09.21 1.15 1.15 0 0 0-.21.33.94.94 0 0 0 0 .76c.05.121.122.233.21.33.097.088.209.16.33.21a1 1 0 0 0 1.09-.21 1.15 1.15 0 0 0 .21-.33.94.94 0 0 0 0-.76 1.15 1.15 0 0 0-.21-.33ZM21 16H7a1 1 0 0 0 0 2h14a1 1 0 0 0 0-2Z"/>',
  database:
    '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v4c0 1.66 4.03 3 9 3s9-1.34 9-3V5"/><path d="M3 9v4c0 1.66 4.03 3 9 3s9-1.34 9-3V9"/><path d="M3 13v4c0 1.66 4.03 3 9 3s9-1.34 9-3v-4"/>',
} as const;
const iconPath = icon ? icons[icon] : null;
---

<a href={href} class="section-card-link">
  <article class="section-card">
    <p class="section-card-title">
      {
        logo ? (
          <span class="section-card-logo" aria-hidden="true" set:html={logo} />
        ) : iconPath ? (
          <span class="section-card-logo" aria-hidden="true">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="currentColor"
              set:html={iconPath}
            />
          </span>
        ) : null
      }
      <span class="section-card-name">{title}</span>
    </p>
    <div class="section-card-body"><slot /></div>
    <span class="section-card-cta">Explore section</span>
  </article>
</a>

<style>
  .section-card-link {
    display: block;
    height: 100%;
    border-radius: 16px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease;
  }
  .section-card-link:focus-visible {
    outline: 3px solid var(--ej-accent);
    outline-offset: 3px;
    border-radius: 16px;
  }
  .section-card-link:hover {
    transform: translateY(-3px);
  }
  .section-card {
    position: relative;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    min-height: 11rem;
    padding: clamp(1.1rem, calc(0.5rem + 2vw), 1.75rem);
    overflow: hidden;
    border: 1px solid var(--ej-line);
    border-radius: 16px;
    background: var(--ej-surface-raised);
    box-shadow: 0 10px 24px rgb(23 32 42 / 5%);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .section-card::after {
    content: "";
    position: absolute;
    right: -2.25rem;
    bottom: -2.75rem;
    width: 6rem;
    height: 6rem;
    border: 1px solid color-mix(in srgb, var(--ej-accent) 22%, transparent);
    border-radius: 50%;
    pointer-events: none;
  }
  .section-card-link:hover .section-card {
    border-color: var(--ej-accent);
    box-shadow: var(--ej-shadow);
  }
  .section-card-title {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0;
    color: var(--ej-ink);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.3;
  }
  .section-card-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    flex-shrink: 0;
    padding: 0.45rem;
    border: 1px solid color-mix(in srgb, var(--ej-accent) 40%, var(--ej-line));
    border-radius: 0.5rem;
    background: var(--ej-accent-soft);
    color: var(--ej-accent);
  }
  .section-card-logo svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
  }
  .section-card-body {
    margin: 0;
    color: var(--ej-muted);
    font-size: 0.85rem;
    line-height: 1.6;
  }
  .section-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: auto;
    padding-top: 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ej-accent);
  }
  .section-card-cta::after {
    content: "→";
    transition: transform 0.2s ease;
  }
  .section-card-link:hover .section-card-cta::after {
    transform: translateX(3px);
  }
</style>
