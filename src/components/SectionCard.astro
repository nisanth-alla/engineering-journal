---
import { Card } from "@astrojs/starlight/components";
import type { StarlightIcon } from "@astrojs/starlight/types";
import BrandCard from "./BrandCard.astro";

interface Props {
  title: string;
  href: string;
  brand?: "go" | "javascript" | "next" | "node" | "react" | "typescript";
  icon?: StarlightIcon;
}

const { title, href, brand, icon } = Astro.props;
---

<a href={href} class="section-card-link">
  {
    brand ? (
      <BrandCard title={title} brand={brand}>
        <slot />
      </BrandCard>
    ) : (
      <Card title={title} icon={icon}>
        <slot />
      </Card>
    )
  }
  <span class="explore-cta" aria-hidden="true">Explore section</span>
</a>

<style>
  .section-card-link {
    display: block;
    height: 100%;
    border-radius: 16px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease;
  }
  .section-card-link:focus-visible {
    outline: 3px solid var(--ej-accent);
    outline-offset: 3px;
    border-radius: 16px;
  }
  .section-card-link:hover {
    transform: translateY(-3px);
  }
  .explore-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: 0.9rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ej-accent);
  }
  .explore-cta::after {
    content: "→";
    transition: transform 0.2s ease;
  }
  .section-card-link:hover .explore-cta::after {
    transform: translateX(3px);
  }
</style>
