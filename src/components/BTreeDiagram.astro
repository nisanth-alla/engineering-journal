---
// Renders the B+ tree diagram as a proper SVG component.
// MDX cannot render SVG text/rect elements correctly (treats them as React components).
// Using an Astro component ensures the SVG is output verbatim.
---

<div class="btree-diagram">
  <svg
    viewBox="0 0 560 230"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="B+ tree structure: root [50], internal nodes [25] and [75], leaf nodes [10,20] [30,40] [60,70] [80,90] linked as a list"
  >
    <!-- Branch edges -->
    <line x1="280" y1="44" x2="160" y2="94" class="bt-edge"></line>
    <line x1="280" y1="44" x2="400" y2="94" class="bt-edge"></line>
    <line x1="160" y1="114" x2="80" y2="164" class="bt-edge"></line>
    <line x1="160" y1="114" x2="200" y2="164" class="bt-edge"></line>
    <line x1="400" y1="114" x2="360" y2="164" class="bt-edge"></line>
    <line x1="400" y1="114" x2="480" y2="164" class="bt-edge"></line>
    <!-- Leaf linked-list arrows -->
    <line x1="112" y1="183" x2="148" y2="183" class="bt-link"></line>
    <line x1="232" y1="183" x2="328" y2="183" class="bt-link"></line>
    <line x1="392" y1="183" x2="448" y2="183" class="bt-link"></line>
    <!-- Root node -->
    <rect x="236" y="20" width="88" height="32" rx="6" class="bt-node-root"></rect>
    <text x="280" y="41" class="bt-label">[50]</text>
    <!-- Internal nodes -->
    <rect x="116" y="94" width="88" height="32" rx="6" class="bt-node-internal"></rect>
    <text x="160" y="115" class="bt-label">[25]</text>
    <rect x="356" y="94" width="88" height="32" rx="6" class="bt-node-internal"></rect>
    <text x="400" y="115" class="bt-label">[75]</text>
    <!-- Leaf nodes -->
    <rect x="34" y="164" width="92" height="32" rx="6" class="bt-node-leaf"></rect>
    <text x="80" y="185" class="bt-label-leaf">[10,20]</text>
    <rect x="154" y="164" width="92" height="32" rx="6" class="bt-node-leaf"></rect>
    <text x="200" y="185" class="bt-label-leaf">[30,40]</text>
    <rect x="314" y="164" width="92" height="32" rx="6" class="bt-node-leaf"></rect>
    <text x="360" y="185" class="bt-label-leaf">[60,70]</text>
    <rect x="434" y="164" width="92" height="32" rx="6" class="bt-node-leaf"></rect>
    <text x="480" y="185" class="bt-label-leaf">[80,90]</text>
    <!-- Legend -->
    <text x="280" y="220" class="bt-legend">leaf nodes linked for range scans</text>
  </svg>
</div>

<style>
  .btree-diagram {
    margin: 1.5rem 0;
    padding: 1rem;
    border: 1px solid var(--ej-line);
    border-radius: 12px;
    background: var(--ej-surface);
    overflow-x: auto;
  }

  .btree-diagram svg {
    display: block;
    width: 100%;
    max-width: 560px;
    height: auto;
    margin: 0 auto;
  }

  .bt-edge {
    stroke: var(--ej-subtle);
    stroke-width: 1.5;
    fill: none;
  }

  .bt-link {
    stroke: var(--ej-accent);
    stroke-width: 2;
    marker-end: url(#arr-fwd);
    marker-start: url(#arr-bwd);
    fill: none;
  }

  .bt-node-root {
    fill: var(--ej-surface-raised);
    stroke: var(--ej-accent);
    stroke-width: 1.5;
  }

  .bt-node-internal {
    fill: var(--ej-surface-raised);
    stroke: var(--ej-line);
    stroke-width: 1.5;
  }

  .bt-node-leaf {
    fill: var(--ej-accent-soft);
    stroke: var(--ej-accent);
    stroke-width: 1;
  }

  .bt-label {
    font-family: var(--sl-font-mono);
    font-size: 13px;
    fill: var(--ej-ink);
    text-anchor: middle;
  }

  .bt-label-leaf {
    font-family: var(--sl-font-mono);
    font-size: 12px;
    fill: var(--ej-accent);
    text-anchor: middle;
    font-weight: 600;
  }

  .bt-legend {
    font-family: var(--sl-font-mono);
    font-size: 11px;
    fill: var(--ej-muted);
    text-anchor: middle;
  }
</style>
