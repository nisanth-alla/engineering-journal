---
// Blue-green deployment — before/after switch, both environments fully boxed.
---

<div class="btree-diagram deploy-diagram">
  <svg
    viewBox="0 0 700 360"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Blue-green: load balancer routes to Blue serving before switch, then to Green serving after switch"
  >
    <!-- ── BEFORE SWITCH ──────────────────────────────────── -->
    <text x="20" y="22" class="dp-eyebrow">Before switch</text>

    <!-- Traffic in -->
    <text x="20" y="60" class="dp-traffic">Traffic</text>
    <line x1="80" y1="56" x2="150" y2="56" class="dp-line dp-line-active"></line>
    <polygon points="150,52 160,56 150,60" class="dp-head dp-head-active"></polygon>

    <!-- Load balancer box -->
    <rect x="160" y="40" width="140" height="32" rx="6" class="dp-lb-box"></rect>
    <text x="230" y="60" class="dp-lb-label">Load balancer</text>

    <!-- Arrow → Blue (active) -->
    <line x1="300" y1="56" x2="368" y2="56" class="dp-line dp-line-active"></line>
    <polygon points="368,52 378,56 368,60" class="dp-head dp-head-active"></polygon>

    <!-- Blue env: serving -->
    <rect x="378" y="32" width="160" height="48" rx="8" class="dp-env dp-blue-on"></rect>
    <text x="458" y="52" class="dp-env-name">Blue (v1)</text>
    <text x="458" y="70" class="dp-env-status dp-status-live">serving</text>

    <!-- Dashed line → Green (inactive) -->
    <line x1="458" y1="80" x2="458" y2="108" class="dp-line dp-line-dim"></line>
    <polygon points="454,108 458,116 462,108" class="dp-head dp-head-dim"></polygon>

    <!-- Green env: staging -->
    <rect x="378" y="116" width="160" height="48" rx="8" class="dp-env dp-green-off"></rect>
    <text x="458" y="136" class="dp-env-name dp-name-dim">Green (v2)</text>
    <text x="458" y="154" class="dp-env-status dp-status-dim">staging</text>

    <!-- ── SWITCH DIVIDER ─────────────────────────────────── -->
    <line x1="20" y1="184" x2="680" y2="184" class="dp-divider"></line>
    <rect x="268" y="173" width="164" height="22" rx="4" class="dp-switch-pill"></rect>
    <text x="350" y="187" class="dp-switch-text">⇄ load balancer switch</text>

    <!-- ── AFTER SWITCH ───────────────────────────────────── -->
    <text x="20" y="218" class="dp-eyebrow">After switch</text>

    <!-- Traffic in -->
    <text x="20" y="256" class="dp-traffic">Traffic</text>
    <line x1="80" y1="252" x2="150" y2="252" class="dp-line dp-line-active"></line>
    <polygon points="150,248 160,252 150,256" class="dp-head dp-head-active"></polygon>

    <!-- Load balancer box -->
    <rect x="160" y="236" width="140" height="32" rx="6" class="dp-lb-box"></rect>
    <text x="230" y="256" class="dp-lb-label">Load balancer</text>

    <!-- Arrow → Green (active now) -->
    <line x1="300" y1="252" x2="368" y2="252" class="dp-line dp-line-green"></line>
    <polygon points="368,248 378,252 368,256" class="dp-head dp-head-green"></polygon>

    <!-- Green env: serving -->
    <rect x="378" y="228" width="160" height="48" rx="8" class="dp-env dp-green-on"></rect>
    <text x="458" y="248" class="dp-env-name">Green (v2)</text>
    <text x="458" y="266" class="dp-env-status dp-status-green">serving</text>

    <!-- Dashed line → Blue (standby) -->
    <line x1="458" y1="276" x2="458" y2="304" class="dp-line dp-line-dim"></line>
    <polygon points="454,304 458,312 462,304" class="dp-head dp-head-dim"></polygon>

    <!-- Blue env: standby — now a proper box -->
    <rect x="378" y="312" width="160" height="40" rx="8" class="dp-env dp-blue-off"></rect>
    <text x="458" y="328" class="dp-env-name dp-name-dim">Blue (v1)</text>
    <text x="458" y="344" class="dp-env-status dp-status-dim">standby</text>
  </svg>
</div>

<style>
  .deploy-diagram {
    overflow: visible;
  }
  .deploy-diagram svg {
    max-width: 700px;
  }

  .dp-eyebrow {
    font-family: var(--sl-font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--ej-subtle);
  }

  .dp-traffic {
    font-family: var(--sl-font-mono);
    font-size: 13px;
    fill: var(--ej-muted);
    alignment-baseline: middle;
  }

  .dp-line {
    stroke-width: 1.8;
    fill: none;
  }
  .dp-line-active {
    stroke: var(--ej-accent);
  }
  .dp-line-green {
    stroke: #22a06b;
  }
  .dp-line-dim {
    stroke: var(--ej-line);
    stroke-dasharray: 5 3;
  }

  .dp-head {
  }
  .dp-head-active {
    fill: var(--ej-accent);
  }
  .dp-head-green {
    fill: #22a06b;
  }
  .dp-head-dim {
    fill: var(--ej-line);
  }

  .dp-lb-box {
    fill: var(--ej-surface);
    stroke: var(--ej-subtle);
    stroke-width: 1.5;
  }

  .dp-lb-label {
    font-family: var(--sl-font-mono);
    font-size: 12px;
    fill: var(--ej-muted);
    text-anchor: middle;
    alignment-baseline: middle;
  }

  /* Environment boxes */
  .dp-env {
    stroke-width: 2;
  }

  .dp-blue-on {
    fill: color-mix(in srgb, #3b82f6 18%, var(--ej-surface));
    stroke: #3b82f6;
  }
  .dp-blue-off {
    fill: var(--ej-surface);
    stroke: var(--ej-line);
  }
  .dp-green-on {
    fill: color-mix(in srgb, #22a06b 18%, var(--ej-surface));
    stroke: #22a06b;
  }
  .dp-green-off {
    fill: var(--ej-surface);
    stroke: var(--ej-line);
  }

  /* Env text */
  .dp-env-name {
    font-family: var(--sl-font-mono);
    font-size: 13px;
    font-weight: 700;
    fill: var(--ej-ink);
    text-anchor: middle;
  }
  .dp-env-name.dp-name-dim {
    fill: var(--ej-subtle);
  }

  .dp-env-status {
    font-family: var(--sl-font-mono);
    font-size: 11px;
    font-weight: 700;
    text-anchor: middle;
  }
  .dp-status-live {
    fill: var(--ej-accent);
  }
  .dp-status-green {
    fill: #22a06b;
  }
  .dp-status-dim {
    fill: var(--ej-subtle);
    font-weight: 400;
  }

  /* Switch divider */
  .dp-divider {
    stroke: var(--ej-line);
    stroke-width: 1;
    stroke-dasharray: 6 4;
  }
  .dp-switch-pill {
    fill: var(--ej-surface-raised);
    stroke: var(--ej-line);
    stroke-width: 1;
  }
  .dp-switch-text {
    font-family: var(--sl-font-mono);
    font-size: 11px;
    fill: var(--ej-muted);
    text-anchor: middle;
    alignment-baseline: middle;
  }
</style>
